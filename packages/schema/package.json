{
  "name": "@packages/schema",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./agent": {
      "types": "./dist/agent.d.mts",
      "default": "./dist/agent.mjs"
    },
    "./message": {
      "types": "./dist/message.d.mts",
      "default": "./dist/message.mjs"
    },
    "./session": {
      "types": "./dist/session.d.mts",
      "default": "./dist/session.mjs"
    },
    "./thread": {
      "types": "./dist/thread.d.mts",
      "default": "./dist/thread.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@packages/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
